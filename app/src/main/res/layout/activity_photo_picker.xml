<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="52dp" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/tvCancelPhotoPicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true"
            android:text="Cancel" android:textColor="@color/kn_text" android:textSize="15sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true"
            android:text="Recents ⌄" android:textColor="@color/kn_text" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvNextPhotoPicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:text="Next (2)" android:textColor="@color/kn_teal" android:textSize="15sp" android:textStyle="bold" />
    </RelativeLayout>

    <RelativeLayout android:layout_width="match_parent" android:layout_height="220dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image1" />
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_alignParentBottom="true" android:layout_margin="12dp"
            android:background="@drawable/kn_circle" android:backgroundTint="#99000000" android:padding="12dp" android:src="@drawable/ic_photo" app:tint="@color/white" />
        <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:layout_margin="12dp"
            android:background="@drawable/kn_pill_teal" android:gravity="center" android:paddingHorizontal="18dp" android:text="SELECT MULTIPLE"
            android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image1" />
                <TextView android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="@color/kn_teal" android:gravity="center" android:text="1" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image2" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image3" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image4" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image5" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image6" />
                <TextView android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="@color/kn_teal" android:gravity="center" android:text="2" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:text="0:23" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image2" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image3" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image4" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image5" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image6" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image1" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image2" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image3" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" android:src="@drawable/image4" />
                <View android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentEnd="true" android:layout_margin="6dp" android:background="@drawable/kn_circle" android:backgroundTint="#66FFFFFF" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:background="@color/white">
        <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="@color/kn_teal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Gallery" android:textColor="@color/kn_teal" android:textSize="16sp" android:textStyle="bold" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Photo" android:textColor="@color/kn_text2" android:textSize="16sp" android:textStyle="bold" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Video" android:textColor="@color/kn_text2" android:textSize="16sp" android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>