<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/kn_teal">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:layout_centerHorizontal="true" android:layout_marginTop="48dp"
        android:text="🔒 End-to-end encrypted" android:textColor="#CCFFFFFF" android:textSize="14sp" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:gravity="center_horizontal" android:orientation="vertical">
        <RelativeLayout android:layout_width="180dp" android:layout_height="180dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/kn_square_tint" android:backgroundTint="#22FFFFFF" />
            <View android:layout_width="156dp" android:layout_height="156dp" android:layout_centerInParent="true" android:background="@drawable/kn_square_tint" android:backgroundTint="#33FFFFFF" />
            <TextView android:layout_width="132dp" android:layout_height="132dp" android:layout_centerInParent="true" android:background="@drawable/kn_square_tint" android:backgroundTint="@color/kn_purple"
                android:gravity="center" android:text="AM" android:textColor="@color/white" android:textSize="48sp" android:textStyle="bold" />
        </RelativeLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ammi ❤" android:textColor="@color/white" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="03:12" android:textColor="#CCFFFFFF" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:gravity="center" android:paddingBottom="48dp" android:paddingHorizontal="24dp">
        <LinearLayout android:id="@+id/btn_video" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/kn_circle" android:backgroundTint="#33FFFFFF" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_menu" app:tint="@color/white" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btn_mute" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="20dp" android:background="@drawable/kn_circle" android:backgroundTint="#33FFFFFF" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_mic" app:tint="@color/white" />
        </LinearLayout>
        <RelativeLayout android:id="@+id/btn_end_call" android:layout_width="84dp" android:layout_height="84dp" android:layout_marginStart="20dp" android:background="@drawable/kn_square_tint" android:backgroundTint="#C62828" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_centerInParent="true" android:src="@drawable/ic_call_end" app:tint="@color/white" />
        </RelativeLayout>
        <LinearLayout android:id="@+id/btn_speaker" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="20dp" android:background="@drawable/kn_circle" android:backgroundTint="#33FFFFFF" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_speaker" app:tint="@color/white" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btn_add_call" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>