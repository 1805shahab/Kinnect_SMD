<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="New"
            android:textColor="@color/kn_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- New block (tinted) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0EEEE"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/notifAisha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">
                <RelativeLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/kn_circle"
                        android:backgroundTint="@color/kn_maroon"
                        android:gravity="center"
                        android:text="AK"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/kn_circle"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="❤️"
                        android:textSize="12sp" />
                </RelativeLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aisha Khan and 32 others reacted to your photo."
                        android:textColor="@color/kn_text"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5m"
                        android:textColor="@color/kn_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="•••"
                    android:textColor="@color/kn_text2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notifSara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">
                <RelativeLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/kn_circle"
                        android:backgroundTint="@color/kn_indigo"
                        android:gravity="center"
                        android:text="SI"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/kn_circle"
                        android:backgroundTint="@color/kn_teal"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="11sp" />
                </RelativeLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sara Iqbal sent you a friend request."
                        android:textColor="@color/kn_text"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20m"
                        android:textColor="@color/kn_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/kn_pill_teal"
                            android:gravity="center"
                            android:text="Confirm"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/kn_pill_gray"
                            android:gravity="center"
                            android:text="Delete"
                            android:textColor="@color/kn_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="•••"
                    android:textColor="@color/kn_text2" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="Earlier"
            android:textColor="@color/kn_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Zain -->
        <LinearLayout
            android:id="@+id/notifZain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">
            <RelativeLayout
                android:layout_width="64dp"
                android:layout_height="64dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="#3F6E8C"
                    android:gravity="center"
                    android:text="ZR"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="@color/kn_green"
                    android:gravity="center"
                    android:text="💬"
                    android:textSize="11sp" />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zain Raza replied to your comment: “next time invite the rest of us”"
                    android:textColor="@color/kn_text"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h"
                    android:textColor="@color/kn_text2"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="•••"
                android:textColor="@color/kn_text2" />
        </LinearLayout>

        <!-- SMD group -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">
            <RelativeLayout
                android:layout_width="64dp"
                android:layout_height="64dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="@color/kn_brown"
                    android:gravity="center"
                    android:text="DC"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="@color/kn_indigo"
                    android:gravity="center"
                    android:text="👥"
                    android:textSize="11sp" />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New post in SMD Class of 2026: “Assignment 1 is out. Start early.”"
                    android:textColor="@color/kn_text"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5h"
                    android:textColor="@color/kn_text2"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="•••"
                android:textColor="@color/kn_text2" />
        </LinearLayout>

        <!-- Hamza -->
        <LinearLayout
            android:id="@+id/notifHamza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">
            <RelativeLayout
                android:layout_width="64dp"
                android:layout_height="64dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="@color/kn_brown"
                    android:gravity="center"
                    android:text="HA"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="#C98A12"
                    android:gravity="center"
                    android:text="🏷"
                    android:textSize="11sp" />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hamza Ali tagged you in a post."
                    android:textColor="@color/kn_text"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yesterday"
                    android:textColor="@color/kn_text2"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="•••"
                android:textColor="@color/kn_text2" />
        </LinearLayout>

        <!-- Lina -->
        <LinearLayout
            android:id="@+id/notifLina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">
            <RelativeLayout
                android:layout_width="64dp"
                android:layout_height="64dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="@color/kn_purple"
                    android:gravity="center"
                    android:text="LM"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/kn_circle"
                    android:backgroundTint="@color/kn_teal"
                    android:gravity="center"
                    android:text="👍"
                    android:textSize="11sp" />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lina Marsh liked your story."
                    android:textColor="@color/kn_text"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2d"
                    android:textColor="@color/kn_text2"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="•••"
                android:textColor="@color/kn_text2" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_margin="16dp"
            android:background="@drawable/kn_pill_gray"
            android:gravity="center"
            android:text="See previous notifications"
            android:textColor="@color/kn_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>